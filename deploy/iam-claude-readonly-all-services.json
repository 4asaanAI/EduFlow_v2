{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOnlyAcrossAllServices",
      "Effect": "Allow",
      "Action": [
        "*:Describe*",
        "*:List*",
        "*:Get*",
        "*:BatchGet*",
        "*:View*",
        "*:Lookup*",
        "*:Search*",
        "*:Check*",
        "*:Estimate*",
        "*:Simulate*",
        "*:Head*",
        "*:Query*",
        "*:Scan*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadActionsThatDoNotUseAReadVerb",
      "Effect": "Allow",
      "Action": [
        "logs:FilterLogEvents",
        "logs:StartQuery",
        "logs:StopQuery",
        "logs:TestMetricFilter",
        "cloudtrail:LookupEvents",
        "elasticbeanstalk:RequestEnvironmentInfo",
        "elasticbeanstalk:RetrieveEnvironmentInfo",
        "elasticbeanstalk:ValidateConfigurationSettings",
        "iam:GenerateServiceLastAccessedDetails",
        "iam:GenerateCredentialReport",
        "ec2:ExportClientVpnClientConfiguration",
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NeverAllowSecretMaterialToBeRead",
      "Effect": "Deny",
      "Action": [
        "secretsmanager:GetSecretValue",
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath",
        "kms:Decrypt",
        "kms:GenerateDataKey*",
        "iam:GetAccessKeyLastUsed",
        "dynamodb:Scan",
        "dynamodb:Query",
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "*"
    }
  ]
}
