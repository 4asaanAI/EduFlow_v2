option_settings:
  # ALB idle timeout — must be >= SSE stream duration.
  # SSE endpoints: /api/chat/conversations/{id}/messages,
  #                /api/attendance/stream, /api/fees/stream,
  #                /api/messaging/stream  (added to this list 2026-08-11 — the setting
  #                is per-environment and already covered it, but a reader checking why
  #                staff chat showed RECONNECTING would not have found it named here)
  #
  # The keepalive is 30 s (services/sse.py KEEPALIVE_SECONDS), comfortably inside this
  # 300 s window and inside EB nginx's 60 s proxy_read_timeout, and every SSE response
  # sets `X-Accel-Buffering: no`. If a stream still drops in production, this pair is
  # not the reason and the network path is where to look.
  # Default EB timeout is 60 s which kills long-running SSE streams.
  aws:elasticbeanstalk:environment:process:default:
    IdleTimeout: 300

  # Disable response buffering on the ALB so SSE chunks flush immediately.
  aws:elbv2:loadbalancer:
    IdleTimeout: 300
